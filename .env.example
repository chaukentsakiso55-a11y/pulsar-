PULSAR_HOST=0.0.0.0
PULSAR_PORT=8000
PULSAR_ENV=development
PULSAR_DB_PATH=data/pulsar.db
# CHANGE THIS before exposing the server to any network.
PULSAR_ADMIN_TOKEN=replace-with-a-long-random-secret

# Native Pulsar-1 checkpoint (optional).
PULSAR_MODEL_CHECKPOINT=

# Pulsar Max routing / reasoning.
PULSAR_PROVIDERS_FILE=configs/providers.local.json
PULSAR_PROVIDER_FALLBACK_FILE=configs/providers.example.json
PULSAR_REASONING_EFFORT=standard
PULSAR_ENABLE_KNOWLEDGE=true
PULSAR_ENABLE_MEMORY=true
PULSAR_RETRIEVAL_LIMIT=4
PULSAR_MAX_ORCHESTRATION_PASSES=5

# Provider API keys are added here by the local provider wizard.
# Example only; do not commit a real key:
# PULSAR_PROVIDER_PRIMARY_API_KEY=

# v0.2 compatibility. New installs should use providers.local.json instead.
PULSAR_ALLOW_UPSTREAM=false
PULSAR_UPSTREAM_BASE_URL=
PULSAR_UPSTREAM_API_KEY=
PULSAR_UPSTREAM_MODEL=

# Comma separated. Leave blank for same-origin only.
PULSAR_CORS_ORIGINS=
